---
import { formatDate, type Post } from '../lib/posts';
import { u } from '../lib/url';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <span class="chip">{p.data.category}</span>
      <h2><a href={u(`/posts/${p.id}/`)}>{p.data.title}</a></h2>
      <p>{p.data.description}</p>
      <div class="meta"><time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time></div>
    </li>
  ))}
</ul>
