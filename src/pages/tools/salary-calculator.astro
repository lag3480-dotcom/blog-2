---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import { SITE } from '../../site.config.mjs';
import table from '../../data/wage-tax-2026.json';
import { calcSalary } from '../../lib/salary.js';

const title = '2026년 연봉 실수령액 계산기 (4대 보험·소득세 자동 계산)';
const description = '연봉과 비과세액, 부양가족 수를 넣으면 2026년 4대 보험 요율과 국세청 근로소득 간이세액표(2026.2.27 개정)로 월 실수령액을 계산합니다. 계산 과정과 연봉별 실수령액 표도 함께 정리했습니다.';
const updated = '2026년 10월 23일';

const won = (n: number) => n.toLocaleString('ko-KR');
// 연봉 3,000만원 ~ 1억원
const quick = [3000, 3500, 4000, 4500, 5000, 6000, 7000, 8000, 10000].map((man) => ({
  annual: man * 10000,
  r: calcSalary(table, { annual: man * 10000, nonTaxMonthly: 200000, family: 1, children: 0 }),
}));
const ex = calcSalary(table, { annual: 40000000, nonTaxMonthly: 200000, family: 1, children: 0 });

const sources = [
  { title: '국가법령정보센터 - 소득세법 시행령 별표2 근로소득 간이세액표 (2026.2.27 개정)', url: 'https://www.law.go.kr/LSW/flDownload.do?flSeq=164357181&bylClsCd=110201' },
  { title: '국가법령정보센터 - 소득세법 제12조 (비과세소득, 식사대 월 20만원)', url: 'https://www.law.go.kr/lsLawLinkInfo.do?lsJoLnkSeq=1000383293&chrClsCd=010202' },
  { title: '정책브리핑 - 2026년 국민연금 보험료율 9.5%', url: 'https://www.korea.kr/news/policyNewsView.do?newsId=148957270' },
  { title: '국민연금공단 - 2026년도 기준소득월액 상·하한액 안내', url: 'https://www.nps.or.kr/pnsgdnc/newgdnc/getOHAE0001M1.do?pstId=ZZ202600000000000147' },
  { title: '국민건강보험공단 EDI - 2026년 건강보험료율·장기요양보험료율 안내', url: 'https://edi.nhis.or.kr/portal/images/popup/20251204_pop01longdesc.html' },
  { title: '정책브리핑 - 2026년 장기요양보험료율 0.9448% (보건복지부)', url: 'https://www.korea.kr/briefing/pressReleaseView.do?newsId=156725039' },
  { title: '국가법령정보센터 - 고용보험 및 산업재해보상보험의 보험료징수 등에 관한 법률 시행령 제12조 (고용보험료율)', url: 'https://www.law.go.kr/LSW/lsLawLinkInfo.do?lsJoLnkSeq=1000953537&chrClsCd=010202' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '2026년 연봉 실수령액 계산기',
  url: new URL('/tools/salary-calculator/', SITE.url).toString(),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  inLanguage: 'ko',
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article>
    <div class="meta"><a href={u('/tools/')}>계산기</a></div>
    <h1>{title}</h1>
    <div class="meta">기준: 2026년 10월 적용 요율 · 최종 수정 {updated}</div>

    <form class="calc" id="salary-form" autocomplete="off">
      <label>
        <span>연봉 (세전, 원)</span>
        <input id="annual" inputmode="numeric" value="40,000,000" />
        <small id="annual-hint"></small>
      </label>
      <label>
        <span>월 비과세액 (원)</span>
        <input id="nontax" inputmode="numeric" value="200,000" />
        <small>식대(월 20만원 한도) 등. 급여명세서의 비과세 합계를 넣으세요.</small>
      </label>
      <div class="row2">
        <label>
          <span>공제대상가족 수 (본인 포함)</span>
          <select id="family">
            {Array.from({ length: 11 }, (_, i) => <option value={i + 1}>{i + 1}명</option>)}
          </select>
        </label>
        <label>
          <span>그중 8세 이상 20세 이하 자녀</span>
          <select id="children">
            {Array.from({ length: 8 }, (_, i) => <option value={i}>{i}명</option>)}
          </select>
        </label>
      </div>
    </form>

    <div class="calc-result" aria-live="polite">
      <div class="net">
        <span>월 예상 실수령액</span>
        <strong id="r-net">-</strong>
        <small id="r-net-year"></small>
      </div>
      <table>
        <tbody>
          <tr><th>월 급여 (연봉 ÷ 12)</th><td id="r-gross">-</td></tr>
          <tr><th>국민연금 (4.75%)</th><td id="r-pension">-</td></tr>
          <tr><th>건강보험 (3.595%)</th><td id="r-health">-</td></tr>
          <tr><th>장기요양보험</th><td id="r-care">-</td></tr>
          <tr><th>고용보험 (0.9%)</th><td id="r-employment">-</td></tr>
          <tr><th>소득세 (간이세액표)</th><td id="r-income">-</td></tr>
          <tr><th>지방소득세 (소득세의 10%)</th><td id="r-local">-</td></tr>
          <tr class="total"><th>공제 합계</th><td id="r-total">-</td></tr>
        </tbody>
      </table>
      <p class="note">회사가 원천징수 비율을 80%·120%로 바꿨거나, 상여·수당이 따로 나오는 달은 실제 금액과 다를 수 있습니다. 10원 미만은 버려 표시합니다.</p>
    </div>

    <div class="prose">
      <p>연봉 계약서의 숫자와 통장에 들어오는 월급은 꽤 차이가 납니다. 매달 <strong>4대 보험료(국민연금·건강보험·장기요양보험·고용보험)</strong>와 <strong>소득세·지방소득세</strong>가 먼저 빠지기 때문입니다.</p>
      <p>이 계산기는 <strong>2026년 10월 현재 적용되는 공식 요율</strong>과 국세청이 원천징수에 쓰는 <strong>근로소득 간이세액표(2026년 2월 27일 개정)</strong>의 실제 표 값을 그대로 넣어 계산합니다. 아래에서 계산 방법과 연봉별 실수령액, 결과가 명세서와 다를 때 확인할 점을 정리했습니다.</p>

      <h2>연봉별 월 실수령액 표 (2026년)</h2>
      <p>본인 1명(부양가족 없음), 비과세 식대 월 20만원을 가정한 값입니다. 계산기와 같은 방식으로 계산했습니다.</p>
      <table>
        <thead><tr><th>연봉</th><th>월 급여</th><th>공제 합계</th><th>월 실수령액</th></tr></thead>
        <tbody>
          {quick.map(({ annual, r }) => (
            <tr><td>{won(annual / 10000)}만원</td><td>{won(r.gross)}원</td><td>{won(r.deductions)}원</td><td><strong>{won(r.net)}원</strong></td></tr>
          ))}
        </tbody>
      </table>
      <p>부양가족이 있으면 소득세가 줄어 실수령액이 늘어납니다. 내 조건은 위 계산기에 직접 넣어 확인하세요.</p>

      <h2>2026년 공제 항목과 요율</h2>
      <table>
        <thead><tr><th>항목</th><th>전체 요율</th><th>근로자 부담</th><th>계산 기준</th></tr></thead>
        <tbody>
          <tr><td>국민연금</td><td>9.5%</td><td>4.75%</td><td>기준소득월액 (하한 41만원, 상한 659만원)</td></tr>
          <tr><td>건강보험</td><td>7.19%</td><td>3.595%</td><td>보수월액 (월 급여 − 비과세)</td></tr>
          <tr><td>장기요양보험</td><td>소득의 0.9448%</td><td>절반</td><td>건강보험료 × (0.9448% ÷ 7.19%)</td></tr>
          <tr><td>고용보험(실업급여)</td><td>1.8%</td><td>0.9%</td><td>월 급여 − 비과세</td></tr>
          <tr><td>소득세</td><td colspan="2">간이세액표 금액</td><td>월 급여 − 비과세, 공제대상가족 수</td></tr>
          <tr><td>지방소득세</td><td colspan="2">소득세의 10%</td><td>소득세</td></tr>
        </tbody>
      </table>
      <ul>
        <li><strong>국민연금</strong>은 2026년부터 보험료율이 9%에서 9.5%로 올랐습니다. 회사와 근로자가 절반씩 냅니다.</li>
        <li><strong>국민연금 기준소득월액</strong>의 상·하한은 매년 7월에 바뀝니다. 2026년 7월부터 2027년 6월까지는 하한 410,000원, 상한 6,590,000원입니다. 그래서 월 과세 급여가 659만원을 넘으면 국민연금은 더 늘지 않습니다.</li>
        <li><strong>장기요양보험료</strong>는 건강보험료에 비율(0.9448 ÷ 7.19, 약 13.14%)을 곱해 계산합니다.</li>
      </ul>

      <h2>계산 예시: 연봉 4,000만원, 본인 1명</h2>
      <p>비과세 식대 월 20만원을 받는 경우를 단계별로 계산해 보겠습니다.</p>
      <ol>
        <li><strong>월 급여</strong>: 40,000,000 ÷ 12 = {won(ex.gross)}원 (원 미만 버림)</li>
        <li><strong>과세 대상 급여</strong>: {won(ex.gross)} − 200,000 = {won(ex.taxable)}원</li>
        <li><strong>국민연금</strong>: 기준소득월액은 천원 미만을 버린 {won(ex.pensionBase)}원. {won(ex.pensionBase)} × 4.75% = 148,817원 → <strong>{won(ex.pension)}원</strong></li>
        <li><strong>건강보험</strong>: {won(ex.taxable)} × 3.595% = 112,643원 → <strong>{won(ex.health)}원</strong></li>
        <li><strong>장기요양보험</strong>: {won(ex.health)} × (0.9448 ÷ 7.19) = 14,801원 → <strong>{won(ex.care)}원</strong></li>
        <li><strong>고용보험</strong>: {won(ex.taxable)} × 0.9% = 28,199원 → <strong>{won(ex.employment)}원</strong></li>
        <li><strong>소득세</strong>: 간이세액표에서 월급여액 3,120천원 이상 3,140천원 미만, 공제대상가족 1명 칸 = <strong>{won(ex.incomeTax)}원</strong></li>
        <li><strong>지방소득세</strong>: {won(ex.incomeTax)} × 10% = <strong>{won(ex.localTax)}원</strong></li>
      </ol>
      <p>공제 합계는 {won(ex.pension)} + {won(ex.health)} + {won(ex.care)} + {won(ex.employment)} + {won(ex.incomeTax)} + {won(ex.localTax)} = <strong>{won(ex.deductions)}원</strong>입니다. 따라서 월 실수령액은 {won(ex.gross)} − {won(ex.deductions)} = <strong>{won(ex.net)}원</strong>입니다.</p>

      <h2>공제대상가족 수와 자녀는 이렇게 넣으세요</h2>
      <ul>
        <li><strong>공제대상가족 수</strong>는 본인을 포함해 기본공제를 받는 가족의 수입니다. 회사에 제출한 <strong>근로소득자 소득·세액 공제신고서</strong>의 인원과 같게 넣으면 명세서와 가장 가깝게 나옵니다.</li>
        <li><strong>8세 이상 20세 이하 자녀</strong>가 있으면 간이세액표 금액에서 자녀 1명은 20,830원, 2명은 45,830원을 빼고, 3명부터는 1명당 33,330원을 더 뺍니다. 빼고 남은 금액이 0원보다 작으면 0원입니다.</li>
        <li>자녀도 공제대상가족 수에 포함됩니다. 예를 들어 본인, 배우자, 자녀 2명이면 공제대상가족 4명, 자녀 2명으로 넣습니다.</li>
      </ul>

      <h2>월 급여가 1,000만원을 넘을 때</h2>
      <p>간이세액표는 월급여액 1,000만원까지 표로 정해져 있고, 그 위로는 계산식이 적용됩니다. 계산기는 아래 식을 그대로 씁니다.</p>
      <table>
        <thead><tr><th>월급여액 (비과세 제외)</th><th>소득세</th></tr></thead>
        <tbody>
          <tr><td>1,000만원 초과 ~ 1,400만원 이하</td><td>1,000만원 세액 + (1,000만원 초과분 × 98% × 35%) + 25,000원</td></tr>
          <tr><td>1,400만원 초과 ~ 2,800만원 이하</td><td>1,000만원 세액 + 1,397,000원 + (1,400만원 초과분 × 98% × 38%)</td></tr>
          <tr><td>2,800만원 초과 ~ 3,000만원 이하</td><td>1,000만원 세액 + 6,610,600원 + (2,800만원 초과분 × 98% × 40%)</td></tr>
          <tr><td>3,000만원 초과 ~ 4,500만원 이하</td><td>1,000만원 세액 + 7,394,600원 + (3,000만원 초과분 × 40%)</td></tr>
          <tr><td>4,500만원 초과 ~ 8,700만원 이하</td><td>1,000만원 세액 + 13,394,600원 + (4,500만원 초과분 × 42%)</td></tr>
          <tr><td>8,700만원 초과</td><td>1,000만원 세액 + 31,034,600원 + (8,700만원 초과분 × 45%)</td></tr>
        </tbody>
      </table>
      <p>여기서 "1,000만원 세액"은 간이세액표의 1,000만원 행에서 내 공제대상가족 수 칸의 금액입니다. 예를 들어 1명이면 1,507,400원입니다.</p>

      <h2>계산 결과가 내 명세서와 다를 때</h2>
      <table>
        <thead><tr><th>원인</th><th>확인할 것</th></tr></thead>
        <tbody>
          <tr><td>원천징수 비율을 80% 또는 120%로 선택</td><td>회사 인사·급여 담당자에게 선택 비율을 확인하세요. 80%면 소득세가 줄고 120%면 늘어납니다.</td></tr>
          <tr><td>비과세 항목이 식대 외에 더 있음</td><td>자가운전보조금, 출산·보육 수당 등 비과세 합계를 명세서에서 확인해 넣으세요.</td></tr>
          <tr><td>국민연금 기준소득월액이 작년 소득 기준</td><td>국민연금은 보통 전년도 소득으로 정한 기준소득월액을 7월부터 1년간 씁니다. 연봉이 올랐어도 바로 반영되지 않을 수 있습니다.</td></tr>
          <tr><td>상여금·성과급·야근수당이 나온 달</td><td>그 달 급여 총액으로 세액이 다시 정해집니다. 계산기는 연봉을 12로 나눈 평월 기준입니다.</td></tr>
          <tr><td>건강보험료 연말정산·정산분</td><td>전년도 보수가 확정되면 정산분이 급여에서 추가로 빠지거나 돌려받을 수 있습니다.</td></tr>
          <tr><td>노조비, 사내 대출 상환 등</td><td>세금·보험료가 아닌 공제 항목은 계산기에 들어 있지 않습니다.</td></tr>
        </tbody>
      </table>

      <h2>자주 묻는 질문</h2>
      <h3>월급을 알고 있으면 연봉 칸에 뭘 넣나요?</h3>
      <p>세전 월급에 12를 곱해 넣으면 됩니다. 예를 들어 세전 월급이 350만원이면 42,000,000원을 넣습니다.</p>
      <h3>간이세액표대로 떼면 세금이 끝난 건가요?</h3>
      <p>아닙니다. 매달 떼는 소득세는 미리 내는 금액입니다. 다음 해 연말정산에서 실제 공제 항목을 반영해 다시 계산하고, 더 냈으면 돌려받고 덜 냈으면 추가로 냅니다.</p>
      <h3>왜 국민연금은 연봉이 높아도 일정 금액에서 멈추나요?</h3>
      <p>국민연금은 기준소득월액 상한(2026년 7월부터 659만원)까지만 보험료를 매깁니다. 그래서 월 과세 급여가 상한을 넘으면 국민연금 보험료는 313,020원에서 더 늘지 않습니다.</p>

      <p class="disclaimer">이 계산기는 공식 요율과 간이세액표로 계산한 <strong>예상치</strong>이며, 회사의 급여 계산 방식과 개인 상황에 따라 실제 금액과 다를 수 있습니다. 정확한 원천징수 세액은 회사 급여 담당자 또는 국세청 126 상담센터에, 보험료는 국민연금공단(1355)·국민건강보험공단(1577-1000)에 확인하세요.</p>
    </div>

    <section class="sources">
      <h2>참고 자료</h2>
      <ol>
        {sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}
      </ol>
    </section>
  </article>
</Base>

<script>
  import table from '../../data/wage-tax-2026.json';
  import { calcSalary } from '../../lib/salary.js';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (s: string) => Number(String(s).replace(/[^0-9]/g, '')) || 0;
  const fmt = (n: number) => n.toLocaleString('ko-KR') + '원';

  function formatInput(el: HTMLInputElement) {
    const v = num(el.value);
    el.value = v ? v.toLocaleString('ko-KR') : '';
  }

  function update() {
    const annual = num($('annual').value);
    const nonTaxMonthly = num($('nontax').value);
    const family = Number($('family').value);
    const childSel = $('children') as unknown as HTMLSelectElement;
    const maxKids = family - 1;
    for (const opt of Array.from(childSel.options)) opt.disabled = Number(opt.value) > maxKids;
    if (Number(childSel.value) > maxKids) childSel.value = String(maxKids);
    const children = Number(childSel.value);

    $('annual-hint').textContent = annual ? `${(annual / 10000).toLocaleString('ko-KR')}만원` : '';
    const r = calcSalary(table, { annual, nonTaxMonthly, family, children });
    $('r-gross').textContent = fmt(r.gross);
    $('r-pension').textContent = fmt(r.pension);
    $('r-health').textContent = fmt(r.health);
    $('r-care').textContent = fmt(r.care);
    $('r-employment').textContent = fmt(r.employment);
    $('r-income').textContent = fmt(r.incomeTax);
    $('r-local').textContent = fmt(r.localTax);
    $('r-total').textContent = fmt(r.deductions);
    $('r-net').textContent = fmt(r.net);
    $('r-net-year').textContent = `연 환산 약 ${fmt(r.net * 12)}`;
  }

  for (const id of ['annual', 'nontax']) {
    $(id).addEventListener('input', (e) => { formatInput(e.target as HTMLInputElement); update(); });
  }
  for (const id of ['family', 'children']) $(id).addEventListener('change', update);
  update();
</script>
