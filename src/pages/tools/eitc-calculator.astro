---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url';
import { SITE } from '../../site.config.mjs';
import table from '../../data/eitc-table.json';
import { tableAmount } from '../../lib/eitc.js';

const title = '근로장려금 계산기 (2025년 소득분, 2026년 신청)';
const description = '가구 유형과 총급여액, 재산을 넣으면 조세특례제한법 시행령의 근로장려금 산정표(2025.2.28 개정) 그대로 예상 지급액을 계산합니다. 재산 50% 감액과 기한 후 신청 95%도 반영합니다.';
const updated = '2026년 10월 23일';

const won = (n: number) => n.toLocaleString('ko-KR');
const sample = [3000000, 5000000, 8000000, 10000000, 15000000, 20000000, 25000000, 30000000, 35000000, 40000000].map((e) => ({
  e,
  s: tableAmount(table, e, 'single'),
  h: tableAmount(table, e, 'hol'),
  m: e < 6000000 ? null : tableAmount(table, e, 'mat'),
}));
const show = (v: number | null) => (v === null ? '해당 없음' : v === 0 ? '-' : `${won(v)}원`);

const sources = [
  { title: '국가법령정보센터 - 조세특례제한법 시행령 [별표 11] 근로장려금 산정표 (2025.2.28 개정)', url: 'https://www.law.go.kr/flDownload.do?flSeq=150043511' },
  { title: '국가법령정보센터 - 조세특례제한법 제100조의5 (근로장려금의 산정)', url: 'https://www.law.go.kr/LSW/lsLawLinkInfo.do?chrClsCd=010202&lsJoLnkSeq=1000662304' },
  { title: '국가법령정보센터 - 조세특례제한법 제10절의2 근로 장려를 위한 조세특례', url: 'https://www.law.go.kr/LSW//lsLawLinkInfo.do?lsJoLnkSeq=1000662217&lsId=001584&chrClsCd=010202&print=print' },
  { title: '정책브리핑(국세청) - 근로장려금 최대 330만 원 지급…6월 1일까지 신청 (2026.4.30.)', url: 'https://www.korea.kr/news/policyNewsView.do?newsId=148963769' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '근로장려금 계산기',
  url: new URL('/tools/eitc-calculator/', SITE.url).toString(),
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  inLanguage: 'ko',
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article>
    <div class="meta"><a href={u('/tools/')}>계산기</a></div>
    <h1>{title}</h1>
    <div class="meta">기준: 근로장려금 산정표 2025.2.28 개정 · 최종 수정 {updated}</div>

    <form class="calc" id="eitc-form" autocomplete="off">
      <label>
        <span>가구 유형</span>
        <select id="type">
          <option value="single">단독가구 (배우자·부양자녀·부양 부모 없음)</option>
          <option value="hol">홑벌이가구 (배우자 소득 300만원 미만, 또는 자녀·부모 부양)</option>
          <option value="mat">맞벌이가구 (본인·배우자 각각 300만원 이상)</option>
        </select>
      </label>
      <label>
        <span>2025년 총급여액등 (부부 합산, 원)</span>
        <input id="earned" inputmode="numeric" value="15,000,000" />
        <small>근로소득 총급여(비과세 제외) + 사업·종교인 소득. 사업소득은 업종별 조정률을 곱한 금액입니다.</small>
      </label>
      <label>
        <span>그 밖의 소득 (이자·배당·연금 등, 원)</span>
        <input id="other" inputmode="numeric" value="0" />
        <small>지급액 계산에는 쓰지 않고, 소득 요건(총소득) 확인에만 씁니다.</small>
      </label>
      <div class="row2">
        <label>
          <span>가구원 재산 합계 (2025.6.1. 기준)</span>
          <select id="assets">
            <option value="0">1억 7,000만원 미만</option>
            <option value="170000000">1억 7,000만원 이상 ~ 2억 4,000만원 미만</option>
            <option value="240000000">2억 4,000만원 이상</option>
          </select>
        </label>
        <label>
          <span>신청 시기</span>
          <select id="late">
            <option value="0">정기신청 (5월)</option>
            <option value="1">기한 후 신청 (~12월 1일)</option>
          </select>
        </label>
      </div>
    </form>

    <div class="calc-result" aria-live="polite">
      <div class="net">
        <span>예상 근로장려금</span>
        <strong id="r-amount">-</strong>
        <small id="r-status"></small>
      </div>
      <table>
        <tbody>
          <tr><th>산정표 금액</th><td id="r-base">-</td></tr>
          <tr><th>재산 1억 7,000만원 이상 (50%)</th><td id="r-half">-</td></tr>
          <tr><th>기한 후 신청 (95%)</th><td id="r-late">-</td></tr>
        </tbody>
      </table>
      <p class="note">자녀장려금은 따로 계산됩니다. 최종 금액은 국세청 심사로 정해집니다. 원 미만은 버려 표시합니다.</p>
    </div>

    <div class="prose">
      <p>근로장려금은 일을 하지만 소득이 적은 가구에 현금으로 주는 제도입니다. 받는 금액은 감으로 정하는 것이 아니라 <strong>조세특례제한법 시행령 [별표 11] 근로장려금 산정표</strong>에 소득 구간별로 정해져 있습니다.</p>
      <p>이 계산기는 2025년 2월 28일 개정된 산정표의 <strong>447개 구간을 그대로</strong> 넣었습니다. 2025년 소득분(2026년 신청)에 적용되는 표이며, 2026년 12월 1일까지인 기한 후 신청에도 같은 표가 쓰입니다. 자격 요건은 <a href={u('/posts/earned-income-tax-credit-late-application-2026/')}>근로장려금 기한 후 신청 글</a>에 자세히 정리했습니다.</p>

      <h2>소득 구간별 근로장려금 (산정표 발췌)</h2>
      <p>재산 1억 7,000만원 미만, 정기신청 기준입니다. 총급여액등이 표의 금액 이상 ~ 10만원 미만 구간에 속할 때 받는 금액입니다.</p>
      <table>
        <thead><tr><th>총급여액등</th><th>단독가구</th><th>홑벌이가구</th><th>맞벌이가구</th></tr></thead>
        <tbody>
          {sample.map((r) => (
            <tr><td>{won(r.e / 10000)}만원</td><td>{show(r.s)}</td><td>{show(r.h)}</td><td>{show(r.m)}</td></tr>
          ))}
        </tbody>
      </table>

      <h2>금액이 정해지는 구조: 늘다가, 평평하다가, 줄어듭니다</h2>
      <p>산정표를 보면 소득에 따라 금액이 세 단계로 움직입니다. 일을 더 할수록 처음에는 장려금이 늘고, 일정 구간에서 최대가 되었다가, 소득 기준에 가까워질수록 줄어듭니다.</p>
      <table>
        <thead><tr><th>가구 유형</th><th>늘어나는 구간</th><th>최대 금액 구간</th><th>줄어드는 구간</th></tr></thead>
        <tbody>
          <tr><td>단독가구</td><td>390만원 미만</td><td>390만 ~ 910만원 미만: <strong>165만원</strong></td><td>910만원부터 줄어 2,200만원 전에 끝남</td></tr>
          <tr><td>홑벌이가구</td><td>690만원 미만</td><td>690만 ~ 1,410만원 미만: <strong>285만원</strong></td><td>1,410만원부터 줄어 3,200만원 전에 끝남</td></tr>
          <tr><td>맞벌이가구</td><td>600만 ~ 790만원 미만</td><td>790만 ~ 1,710만원 미만: <strong>330만원</strong></td><td>1,710만원부터 줄어 4,400만원 전에 끝남</td></tr>
        </tbody>
      </table>
      <p>그래서 소득이 아주 적을 때는 <strong>일을 조금 더 하는 것이 장려금도 늘리는</strong> 구조입니다. 반대로 줄어드는 구간에서는 소득이 늘어난 만큼 장려금이 조금씩 줄어듭니다.</p>

      <h2>계산 예시</h2>
      <h3>예시 1. 단독가구, 총급여 1,500만원</h3>
      <p>산정표에서 1,500만원 이상 1,510만원 미만 구간의 단독가구 금액은 <strong>889,000원</strong>입니다. 재산이 1억 7,000만원 미만이고 정기신청이면 그대로 889,000원입니다.</p>
      <h3>예시 2. 맞벌이가구, 총급여 합계 2,500만원, 재산 1억 8,000만원, 기한 후 신청</h3>
      <ol>
        <li>산정표 2,500만원 이상 2,510만원 미만 구간의 맞벌이 금액: <strong>2,323,000원</strong></li>
        <li>재산이 1억 7,000만원 이상이므로 50%: 2,323,000 × 50% = 1,161,500원</li>
        <li>기한 후 신청이므로 95%: 1,161,500 × 95% = <strong>1,103,425원</strong></li>
      </ol>
      <p>정기신청이었다면 1,161,500원이었을 금액이 기한 후 신청으로 58,075원 줄었습니다. 그래도 신청하지 않으면 0원이므로, 대상이라면 기한 안에 신청하는 것이 낫습니다.</p>

      <h2>입력할 때 주의할 점</h2>
      <table>
        <thead><tr><th>항목</th><th>확인할 것</th></tr></thead>
        <tbody>
          <tr><td>총급여액등</td><td>근로소득은 비과세를 뺀 총급여입니다. 회사에서 받은 <strong>근로소득 원천징수영수증</strong>의 총급여 칸을 보거나 홈택스에서 지급명세서를 조회하세요.</td></tr>
          <tr><td>사업소득</td><td>사업소득은 수입금액 그대로가 아니라 업종별 조정률을 곱해 계산합니다. 조정률은 업종마다 달라 이 계산기에서는 직접 계산한 금액을 넣어야 합니다. 홈택스 신청 화면에서 자동 계산됩니다.</td></tr>
          <tr><td>부부 합산</td><td>배우자가 있으면 배우자의 소득도 합쳐 판단합니다.</td></tr>
          <tr><td>재산</td><td>주택, 토지, 자동차, 전세보증금, 예금 등을 합치며 <strong>대출 같은 부채는 빼지 않습니다</strong>.</td></tr>
        </tbody>
      </table>

      <h2>이런 경우 결과가 0원으로 나옵니다</h2>
      <ul>
        <li><strong>소득 기준 초과</strong>: 부부 합산 총소득이 단독 2,200만원, 홑벌이 3,200만원, 맞벌이 4,400만원 이상이면 대상이 아닙니다. 이자·배당·연금 소득도 총소득에 들어갑니다.</li>
        <li><strong>재산 2억 4,000만원 이상</strong>: 가구원 재산 합계가 2억 4,000만원 이상이면 받을 수 없습니다.</li>
        <li><strong>맞벌이인데 합계가 600만원 미만</strong>: 맞벌이가구는 본인과 배우자가 각각 300만원 이상이어야 하므로 산정표에서 600만원 미만은 '해당 없음'입니다. 이때는 가구 유형이 홑벌이에 해당하는지 확인하세요.</li>
        <li><strong>산정표 끝 구간</strong>: 소득 기준 바로 아래의 몇몇 구간은 산정표상 금액이 없습니다.</li>
      </ul>

      <h2>자주 묻는 질문</h2>
      <h3>계산기 결과와 국세청 안내문 금액이 다릅니다.</h3>
      <p>국세청은 신청 뒤에 금융재산, 가구원 정보 등을 다시 심사합니다. 사업소득 조정률, 재산 평가액, 가구 유형 판단이 달라지면 금액도 달라집니다. 안내문 금액도 확정은 아니니 홈택스의 심사 결과를 기준으로 보세요.</p>
      <h3>반기 근로장려금도 이걸로 계산하나요?</h3>
      <p>반기 근로장려금은 산정표 금액의 35%로 정해져 있고, 나중에 정산합니다. 이 계산기는 1년치(정기·기한 후 신청) 금액만 계산합니다.</p>
      <h3>자녀장려금도 함께 계산되나요?</h3>
      <p>아닙니다. 자녀장려금은 따로 계산하며, 2025년 소득분 기준 자녀 1명당 50만~100만원입니다. 이 계산기는 근로장려금만 다룹니다.</p>

      <p class="disclaimer">이 계산기는 법령의 산정표로 계산한 <strong>예상치</strong>이며, 가구 유형·소득·재산 판단에 따라 실제 지급액은 달라질 수 있습니다. 정확한 자격과 금액은 국세청 장려금 상담센터(1566-3636) 또는 국세청 126에 확인하세요.</p>
    </div>

    <section class="sources">
      <h2>참고 자료</h2>
      <ol>
        {sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}
      </ol>
    </section>
  </article>
</Base>

<script>
  import table from '../../data/eitc-table.json';
  import { calcEitc } from '../../lib/eitc.js';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (s: string) => Number(String(s).replace(/[^0-9]/g, '')) || 0;
  const fmt = (n: number) => n.toLocaleString('ko-KR') + '원';

  function update() {
    const r = calcEitc(table, {
      type: $('type').value,
      earned: num($('earned').value),
      otherIncome: num($('other').value),
      assets: Number($('assets').value),
      late: $('late').value === '1',
    });
    $('r-amount').textContent = fmt(r.amount);
    $('r-status').textContent = r.eligible ? '산정표 기준 예상 금액입니다.' : r.reasons.join(' ');
    $('r-base').textContent = fmt(r.base);
    $('r-half').textContent = r.halfApplied ? '적용' : '해당 없음';
    $('r-late').textContent = r.late ? '적용' : '해당 없음';
  }

  for (const id of ['earned', 'other']) {
    $(id).addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      const v = num(el.value);
      el.value = v ? v.toLocaleString('ko-KR') : '';
      update();
    });
  }
  for (const id of ['type', 'assets', 'late']) $(id).addEventListener('change', update);
  update();
</script>
