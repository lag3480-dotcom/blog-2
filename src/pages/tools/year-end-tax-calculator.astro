</Base>

<script>
  import table from '../../data/wage-tax-2026.json';
  import { calcSalary } from '../../lib/salary.js';
  import { calcYearEnd } from '../../lib/yearend.js';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (s: string) => Number(String(s).replace(/[^0-9]/g, '')) || 0;
  const fmt = (n: number) => Math.round(n).toLocaleString('ko-KR') + '원';
  const NUM_IDS = ['total', 'paid', 'pension', 'social', 'credit', 'debit', 'market', 'saving', 'irp', 'rent', 'medSpecial', 'medGeneral'];

  function formatInput(el: HTMLInputElement) {
    const v = num(el.value);
    el.value = v ? v.toLocaleString('ko-KR') : '';
  }

  function clampKids(id: string, max: number) {
    const sel = $(id) as unknown as HTMLSelectElement;
    for (const opt of Array.from(sel.options)) opt.disabled = Number(opt.value) > max;
    if (Number(sel.value) > max) sel.value = String(Math.max(max, 0));
    return Number(sel.value);
  }

  function update() {
    const total = num($('total').value);
    const family = Number($('family').value);
    const kids20 = clampKids('kids20', family - 1);
    const kidsCredit = clampKids('kidsCredit', kids20);

    // 보험료·기납부세액 추정: 연봉 실수령액 계산기와 같은 요율·간이세액표(100%)
    const s = calcSalary(table, { annual: total, nonTaxMonthly: 0, family, children: kidsCredit });
    const estPension = s.pension * 12;
    const estSocial = (s.health + s.care + s.employment) * 12;
    const estPaid = s.incomeTax * 12;
    const pension = $('pension').value ? num($('pension').value) : estPension;
    const social = $('social').value ? num($('social').value) : estSocial;
    const paidGiven = $('paid').value !== '';
    const paid = paidGiven ? num($('paid').value) : estPaid;
    $('ins-hint').textContent = `비워 두면 추정값을 씁니다: 국민연금 ${fmt(estPension)}, 건강·장기요양·고용 ${fmt(estSocial)}`;
    $('paid-hint').textContent = paidGiven ? '입력한 금액으로 계산합니다.' : `비워 두면 간이세액표(100%) 추정값 ${fmt(estPaid)}으로 계산합니다.`;
    $('total-hint').textContent = total ? `${(total / 10000).toLocaleString('ko-KR')}만원 · 연봉에서 비과세를 뺀 금액` : '연봉에서 식대 등 비과세를 뺀 금액입니다.';

    const r = calcYearEnd({
      total, family, pension, social,
      cards: { credit: num($('credit').value), debit: num($('debit').value), market: num($('market').value) },
      cardKids: kids20, childCreditKids: kidsCredit, birth: Number(($('birth') as unknown as HTMLSelectElement).value),
      saving: num($('saving').value), irp: num($('irp').value), rent: num($('rent').value),
      medGeneral: num($('medGeneral').value), medSpecial: num($('medSpecial').value), paid,
    });

    $('r-label').textContent = r.refund >= 0 ? '예상 환급액' : '예상 추가 납부액';
    $('r-refund').textContent = fmt(Math.abs(r.refund));
    $('r-total').textContent = fmt(r.total);
    $('r-eid').textContent = fmt(r.eid);
    $('r-earned').textContent = fmt(r.earned);
    $('r-personal').textContent = fmt(r.personal);
    $('r-ins').textContent = fmt(r.insurance);
    $('r-card').textContent = fmt(r.card.deduction);
    $('r-base').textContent = fmt(r.taxBase);
    $('r-calc').textContent = fmt(r.calcTax);
    $('r-eic').textContent = fmt(r.eic);
    $('r-child').textContent = fmt(r.child);
    $('r-pen').textContent = fmt(r.pen.credit);
    $('r-special-label').textContent = r.useStandard ? '− 표준세액공제' : '− 월세·의료비 세액공제';
    $('r-special').textContent = fmt(r.special);
    $('r-decided').textContent = fmt(r.decided);
    $('r-paid').textContent = fmt(r.paid);
    $('r-local').textContent = fmt(r.paidLocal - r.decidedLocal);

    const notes = [];
    if (r.card.gross === 0 && total > 0) notes.push(`카드 사용액이 총급여의 25%(${fmt(r.card.threshold)})를 넘지 않아 카드 공제가 없습니다.`);
    if (total > 80000000 && num($('rent').value) > 0) notes.push('총급여 8천만원 초과라 월세 세액공제를 받을 수 없습니다.');
    if (r.calcTax > 0 && r.decided === 0) notes.push('세액공제가 산출세액보다 커서 결정세액이 0원입니다. 남는 공제는 돌려받지 못합니다.');
    notes.push('원 단위 이하는 버려 표시합니다.');
    $('r-note').textContent = notes.join(' ');
  }

  for (const id of NUM_IDS) {
    $(id).addEventListener('input', (e) => { formatInput(e.target as HTMLInputElement); update(); });
  }
  for (const id of ['family', 'kids20', 'kidsCredit', 'birth']) $(id).addEventListener('change', update);
  update();
</script>
